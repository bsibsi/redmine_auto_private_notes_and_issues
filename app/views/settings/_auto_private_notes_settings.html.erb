<% roles = Role.sorted.all %>

<p>
  <label for="settings_role_ids">
    Select roles for which private notes should be automatically checked:
  </label>
</p>

<p id="settings_role_ids">
  <% roles.each do |role| %>
    <label>
      <%= h role.name %>
      <%= check_box_tag 'settings[role_ids][]', role.id, @settings['role_ids']&.include?(role.id.to_s) %>
    </label><br>
  <% end %>
</p>
